# Kopieren nach .env und anpassen (.env wird nicht eingecheckt)

# ---- HTTPS über eigene Domain (für den Bewegungssensor auf iPhones) ----
# Name, unter dem die Handys verbinden (zeigt per CNAME auf DESEC_ZONE)
PUBLIC_DOMAIN=lan-party.ma-und-ma.de

# deSEC: kostenlose Zone + API-Token (desec.io → Token Management)
DESEC_ZONE=lan-abfahrt.dedyn.io
DESEC_TOKEN=

# E-Mail für Let's Encrypt (Hinweise zum Ablauf, optional)
ACME_EMAIL=

# Zum Ausprobieren: Test-Zertifikate von Let's Encrypt (Browser vertrauen ihnen nicht)
# ACME_STAGING=1

# Zertifikat + Schlüssel (Standard: certs/fullchain.pem und certs/privkey.pem)
# TLS_CERT=certs/fullchain.pem
# TLS_KEY=certs/privkey.pem

# ---- Netzwerk ----
# Ports: HTTP (TV, Bots, alles ohne Bewegungssensor) und HTTPS (Handys)
# PORT=3000
# HTTPS_PORT=3443

# Falls die automatisch erkannte Laptop-IP falsch ist
# PUBLIC_HOST=192.168.178.23
