{
  "name": "lan-abfahrt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Party-Spiel für die Freundesgruppe – TV zeigt das Spiel, Handys sind die Controller.",
  "scripts": {
    "dev": "tsx watch --ignore ./client --ignore ./dist server/index.ts",
