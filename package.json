    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.9.0"
  }
